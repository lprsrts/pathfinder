# Copy to scripts/release.env (not committed) and fill in for your setup.
PATHFINDER_NOTARY_PROFILE=your-notarytool-profile
PATHFINDER_PUBLISH_TO=your-server:/srv/state/pathfinder/public
PATHFINDER_COLLECTOR_URL=https://pathfinder.example.com
PATHFINDER_DEPLOY_HOST=your-server
# PATHFINDER_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# PATHFINDER_BUNDLE_ID=com.example.pathfinder
# Purging the edge cache after a release (a token with Cache Purge permission):
# PATHFINDER_CF_ZONE=your-cloudflare-zone-id
# PATHFINDER_CF_TOKEN_SERVICE=your-keychain-item
